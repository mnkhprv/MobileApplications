<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/currencyListFragment">

    <fragment
        android:id="@+id/currencyListFragment"
        android:name="com.example.moneyconverter.CurrencyListFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_currency_list">

        <action
            android:id="@+id/action_currencyListFragment_to_moneyConverterFragment"
            app:destination="@id/moneyConverterFragment" />
    </fragment>

    <fragment
        android:id="@+id/moneyConverterFragment"
        android:name="com.example.moneyconverter.MoneyConverterFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_money_converter">

        <argument
            android:name="currencyCode"
            app:argType="string" />
    </fragment>
</navigation>
