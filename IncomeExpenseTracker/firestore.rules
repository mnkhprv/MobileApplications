rules_version = '2';

// Each user can read and write only their own data under users/{uid}.
// Everything else is closed. Paste into Firebase console → Firestore →
// Rules, or deploy with `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
